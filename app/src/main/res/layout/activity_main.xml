<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d0d0d"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:text="SF EMERALD DYNASTY"
        android:textColor="#f5c842"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:text="FIDUCIARY TREASURY WALLET"
        android:textColor="#666666"
        android:textSize="9sp"
        android:letterSpacing="0.15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"/>

    <!-- Card Container -->
    <androidx.cardview.widget.CardView
        xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="12dp"
        card_view:cardBackgroundColor="#1a1a1a">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1a1a1a"
            android:padding="20dp">

            <!-- Top row: issuer only (no network logo) -->
            <TextView
                android:id="@+id/tv_issuer"
                android:text="SF EMERALD DYNASTY"
                android:textColor="#f5c842"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"/>

            <TextView
                android:id="@+id/tv_treasury_label"
                android:text="TREASURY"
                android:textColor="#888888"
                android:textSize="8sp"
                android:letterSpacing="0.15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"/>

            <!-- Chip -->
            <LinearLayout
                android:id="@+id/chip_area"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:layout_below="@id/tv_issuer"
                android:layout_alignParentStart="true"
                android:layout_marginTop="16dp"
                android:background="#c8a84b"
                android:orientation="vertical"
                android:gravity="center">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#a07830"/>
            </LinearLayout>

            <!-- NFC tap icon -->
            <TextView
                android:id="@+id/tv_nfc"
                android:text="(((•"
                android:textColor="#f5c842"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_issuer"
                android:layout_marginTop="20dp"
                android:layout_marginStart="56dp"
                android:layout_alignParentStart="true"/>

            <!-- PAN -->
            <TextView
                android:id="@+id/tv_pan"
                android:text="GCAT  0001  2500  0000"
                android:textColor="#f0f0f0"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>

            <!-- Expiry -->
            <TextView
                android:id="@+id/tv_exp_label"
                android:text="VALID THRU"
                android:textColor="#666666"
                android:textSize="7sp"
                android:letterSpacing="0.1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_marginBottom="18dp"/>

            <TextView
                android:id="@+id/tv_expiry"
                android:text="12/28"
                android:textColor="#f0f0f0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_toEndOf="@id/tv_exp_label"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="16dp"/>

            <!-- Cardholder -->
            <TextView
                android:id="@+id/tv_name"
                android:text="DENNIS / DASHAWN-TERRELL"
                android:textColor="#cccccc"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginBottom="16dp"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Balance -->
    <TextView
        android:text="TREASURY BALANCE"
        android:textColor="#444444"
        android:textSize="9sp"
        android:letterSpacing="0.2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"/>

    <TextView
        android:text="$250,000.00"
        android:textColor="#f5c842"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>

    <TextView
        android:text="USD · Stellar Network · GCATMWLZ"
        android:textColor="#444444"
        android:textSize="9sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"/>

    <!-- Tap to Pay button -->
    <TextView
        android:id="@+id/btn_tap"
        android:text="⬤  TAP TO PAY"
        android:textColor="#0d0d0d"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:background="#f5c842"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <!-- Status -->
    <TextView
        android:id="@+id/tv_status"
        android:text=""
        android:textColor="#f5c842"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <!-- jPOS log -->
    <TextView
        android:id="@+id/tv_log"
        android:text=""
        android:textColor="#444444"
        android:textSize="9sp"
        android:gravity="center"
        android:fontFamily="monospace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
